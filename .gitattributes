# Keep serialized Unity assets and source text stable across platforms.
* text=auto
*.cs text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
